diff --git a/gcc/config.gcc b/gcc/config.gcc
index c5064dd37..b5518f664 100644
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -1079,6 +1079,13 @@ case ${target} in
       ;;
   esac
   ;;
+*-*-rook*)
+  extra_options="$extra_options gnu-user.opt"
+  gas=yes
+  gnu_ld=yes
+  default_use_cxa_atexit=yes
+  use_gcc_stdint=provide
+  ;;
 *-*-elf|arc*-*-elf*)
   # Assume that newlib is being used and so __cxa_atexit is provided.
   default_use_cxa_atexit=yes
@@ -2246,6 +2253,13 @@ x86_64-*-fuchsia*)
 	tmake_file="${tmake_file} i386/t-x86_64-elf"
 	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h newlib-stdint.h i386/i386elf.h i386/x86-64.h fuchsia.h"
 	;;
+i[34567]86-*-rook*)
+	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h i386/i386elf.h rook.h gnu-user.h"
+	;;
+x86_64-*-rook*)
+	tmake_file="${tmake_file} i386/t-x86_64-rook"
+	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h i386/i386elf.h i386/x86-64.h rook.h gnu-user.h"
+	;;
 ia64*-*-elf*)
 	tm_file="${tm_file} dbxelf.h elfos.h newlib-stdint.h ia64/sysv4.h ia64/elf.h"
 	tmake_file="ia64/t-ia64"
diff --git a/gcc/config/i386/t-x86_64-rook b/gcc/config/i386/t-x86_64-rook
new file mode 100644
index 000000000..8223e63c0
--- /dev/null
+++ b/gcc/config/i386/t-x86_64-rook
@@ -0,0 +1,2 @@
+MULTILIB_OPTIONS += mno-red-zone
+MULTILIB_DIRNAMES += no-red-zone
diff --git a/gcc/config/rook.h b/gcc/config/rook.h
new file mode 100644
index 000000000..b8db1d368
--- /dev/null
+++ b/gcc/config/rook.h
@@ -0,0 +1,23 @@
+#undef TARGET_ROOK
+#define TARGET_ROOK 1
+
+#undef LIB_SPEC
+#define LIB_SPEC "-lc -lsp_core"
+
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "crt0.o%s crti.o%s crtbegin.o%s"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s crtn.o%s"
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS() do {\
+		builtin_define("__rook__");\
+		builtin_define("__unix__");\
+		builtin_assert("system=rook");\
+		builtin_assert("system=unix");\
+		builtin_assert("system=posix");\
+	} while(0);
+
+#undef LINK_SPEC
+#define LINK_SPEC "%{shared:-shared} %{static:-static} %{!shared: %{!static: %{rdynamic:-export-dynamic}}} -z max-page-size=4096"
